# Copy to .env and edit. Every value is optional; the defaults suit a standard checkout.

# Load model weights from this directory instead of the Hugging Face Hub.
# WAXAL_MODELS_DIR=models

# Hugging Face namespace holding the published arms.
# WAXAL_HF_NAMESPACE=anyantudre

# Hugging Face token. Not needed: every repository this solution downloads is public.
# HF_TOKEN=
